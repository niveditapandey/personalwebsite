---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const allTags = [...new Set(articles.flatMap(article => article.data.tags))];
---

<BaseLayout
  title="Insights - Nivedita Pandey"
  description="NitiScope decodes India's public-procurement record - 4.9M government awards - to reveal where spending faces no real competition and who actually wins. By Dendrons.ai."
  ogTitle="NitiScope - India's Public Procurement, Decoded"
  ogImage="https://nitiscope.com/og.png"
>
  <div class="articles-page">
    <header class="page-header">
      <h1>Insights</h1>
      <p class="page-description">
        Long-form writing on technology, institutions, and society.
      </p>
    </header>

    <!-- NitiScope findings card -->
    <div class="nitiscope-card">
      <div class="nitiscope-header">
        <div>
          <span class="nitiscope-tag">Procurement intelligence</span>
          <h2 class="nitiscope-title">NitiScope</h2>
          <p class="nitiscope-sub">What does India's public-procurement record actually reveal?</p>
        </div>
        <span class="nitiscope-by">by Dendrons.ai</span>
      </div>
      <div class="nitiscope-findings">
        <div class="finding">
          <span class="finding-stat">1 in 8</span>
          <span class="finding-label">government awards drew only a single bidder</span>
        </div>
        <div class="finding">
          <span class="finding-stat">3x</span>
          <span class="finding-label">less competitive - central procurement vs. states</span>
        </div>
        <div class="finding">
          <span class="finding-stat">4.9M</span>
          <span class="finding-label">awards across India's entire procurement record, queryable</span>
        </div>
      </div>
      <a href="https://nitiscope.com" target="_blank" rel="noopener" class="nitiscope-cta">Explore more at nitiscope.com →</a>
    </div>

    {allTags.length > 0 && (
      <div class="tags-filter">
        {allTags.map(tag => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    )}

    <div class="articles-list">
      {articles.map((article) => (
        <article class="article-card">
          <a href={`/insights/${article.slug}`}>
            <time datetime={article.data.publishDate.toISOString()}>
              {article.data.publishDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </time>
            <h2>{article.data.title}</h2>
            <p class="article-description">{article.data.description}</p>
            <div class="article-tags">
              {article.data.tags.map(tag => (
                <span class="tag-small">{tag}</span>
              ))}
            </div>
          </a>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .articles-page {
    max-width: 900px;
  }

  .page-header {
    margin-bottom: 3rem;
  }

  .page-header h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    font-weight: 500;
  }

  .page-description {
    font-size: 1.125rem;
    color: var(--text-secondary);
  }

  /* NitiScope findings card */
  .nitiscope-card {
    margin-bottom: 3rem;
    padding: 1.75rem;
    border: 1px solid rgba(96, 165, 250, 0.2);
    border-radius: 6px;
    background: rgba(96, 165, 250, 0.04);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .nitiscope-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .nitiscope-tag {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.2rem 0.65rem;
    border-radius: 20px;
    border: 1px solid rgba(96, 165, 250, 0.35);
    color: var(--accent);
    margin-bottom: 0.6rem;
  }

  .nitiscope-title {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 0.3rem;
    font-family: var(--font-heading);
    line-height: 1.2;
  }

  .nitiscope-sub {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin: 0;
    font-style: italic;
    line-height: 1.5;
  }

  .nitiscope-by {
    font-family: var(--font-heading);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    white-space: nowrap;
    flex-shrink: 0;
    padding-top: 0.2rem;
  }

  .nitiscope-findings {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    padding: 1.25rem 0;
    border-top: 1px solid rgba(96, 165, 250, 0.15);
    border-bottom: 1px solid rgba(96, 165, 250, 0.15);
  }

  .finding {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .finding-stat {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--accent);
    line-height: 1;
  }

  .finding-label {
    font-family: var(--font-heading);
    font-size: 0.78rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  .nitiscope-cta {
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
    transition: opacity 0.2s ease;
    align-self: flex-start;
  }

  .nitiscope-cta:hover {
    opacity: 0.7;
  }

  @media (max-width: 600px) {
    .nitiscope-findings {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  /* Tags filter */
  .tags-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .tag {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--border);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .tag:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Articles list */
  .articles-list {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .article-card {
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--border);
  }

  .article-card:last-child {
    border-bottom: none;
  }

  .article-card a {
    display: block;
    color: inherit;
  }

  .article-card time {
    display: block;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .article-card h2 {
    font-size: 1.75rem;
    margin-bottom: 1rem;
    color: var(--text-primary);
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .article-card:hover h2 {
    color: var(--accent);
  }

  .article-description {
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag-small {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    padding: 0.25rem 0.75rem;
    background: rgba(125, 166, 255, 0.1);
    color: var(--accent);
    border-radius: 3px;
  }

  @media (max-width: 768px) {
    .page-header h1 {
      font-size: 2rem;
    }

    .project-name {
      font-size: 1.5rem;
    }
  }
</style>
