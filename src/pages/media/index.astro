---
import BaseLayout from '../../layouts/BaseLayout.astro';

type Photo = { src: string; caption: string; position?: string; tall?: boolean; contain?: boolean };
type SubSection = { label: string; photos: Photo[] };

const skipaSections: SubSection[] = [
  {
    label: "Applied AI and Digital Innovation in Governance",
    photos: [
      { src: "/media/SKIPA-Lecture_AIGovernance-Jharkhand_Mar17.jpeg", caption: "AI Governance, Jan 2026" },
      { src: "/media/SKIPA-Lecture_GenAI-Slide_Feb27.jpg", caption: "GenAI lecture, Feb 2026" },
      { src: "/media/SKIPA-Lecture_AlgorithmicBias_Feb24.jpg", caption: "Algorithmic Bias, Feb 2026" },
      { src: "/media/SKIPA-Lecture_AIToolsInAction_Feb27.jpg", caption: "AI Tools in Action, Feb 2026", contain: true },
      { src: "/media/SKIPA-Lecture_AudienceView_Mar05.jpg", caption: "AI in War (1)" },
      { src: "/media/SKIPA-Lecture_HandRaised_Mar05.jpg", caption: "AI in War (2)", contain: true },
      { src: "/media/SKIPA-Lecture_PolicyToPrototype_Mar07.jpeg", caption: "Policy to Prototype, Mar 2026", contain: true },
      { src: "/media/SKIPA-Lecture_QRCode_Mar07.jpeg", caption: "Closing session of Applied AI lectures" },
    ]
  },
  {
    label: "Valedictory Ceremony",
    photos: [
      { src: "/media/SKIPA-Convocation_LampLighting.JPG", caption: "Lamp lighting" },
      { src: "/media/SKIPA-Convocation_PlantGift.JPG", caption: "Felicitation" },
      { src: "/media/SKIPA-Convocation_ValedictorySpeech.JPG", caption: "Valedictory speech" },
      { src: "/media/SKIPA-Convocation_CertificateHandover.JPG", caption: "Certificate distribution" },
    ]
  },
];
---

<BaseLayout title="Media - Nivedita Pandey" description="TV interviews, webinars, op-eds in The Pioneer, and events including Applied AI at Coal India institutions (IICM & CMPDIL), IIM Ranchi, and State's Administrative Training Institute AI governance lectures.">
  <div class="media-page">
    <header class="page-header">
      <h1>Media</h1>
      <p class="page-description">
        Interviews, webinars, panels, and public appearances.
      </p>
    </header>

    <!-- TV & Video -->
    <section class="media-section">
      <h2 class="section-title">TV &amp; Video</h2>
      <div class="video-grid">

        <div class="video-item">
          <div class="video-embed">
            <iframe
              src="https://www.youtube.com/embed/Kw0LkPl5Dco"
              title="AI Readiness: Why 75% of AI Projects Fail and How to Get It Right"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
          <div class="video-meta">
            <p class="video-title">AI Readiness: Why 75% of AI Projects Fail and How to Get It Right</p>
            <p class="video-host"><a href="https://squirro.com/" target="_blank" rel="noopener noreferrer">Squirro ↗</a> · Webinar · Feb 2025</p>
            <p class="video-outlet-desc">Swiss enterprise GenAI platform specialising in knowledge intelligence and insight engines</p>
            <p class="video-description">On AI adoption failure modes, organisational readiness, and what separates AI initiatives that succeed from those that stall - drawing on experience across government, financial services, and enterprise.</p>
          </div>
        </div>

        <div class="video-item video-item--upcoming">
          <div class="video-embed video-embed--photo">
            <img src="/media/Doordarshan-Samprati-Interview.jpg" alt="On set of Doordarshan's Samprati, recording an interview on AI & Its Impact on Us" loading="lazy" />
            <span class="upcoming-badge">Yet to be telecast</span>
          </div>
          <div class="video-meta">
            <p class="video-title">Responsible AI: Balancing Opportunity and Risk Across Sectors</p>
            <p class="video-host">Doordarshan · Samprati (सम्प्रति) · Interview · Airing Sep 2026</p>
          </div>
        </div>

        <div class="video-item">
          <div class="video-embed">
            <iframe
              src="https://www.youtube.com/embed/A2-Htz_lUJ8"
              title="AI and Its Transformative Global Impact"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
          <div class="video-meta">
            <p class="video-title">AI and Its Transformative Global Impact</p>
            <p class="video-host">Doordarshan · Interview · Apr 2026</p>
          </div>
        </div>

        <div class="video-item">
          <div class="video-embed">
            <iframe
              src="https://www.youtube.com/embed/-ZH-s0Lzc5w"
              title="AI's Impact on the World - Part 1"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
          <div class="video-meta">
            <p class="video-title">AI's Impact on the World - Part 1</p>
            <p class="video-host">Naxatra News · Interview · May 2026</p>
            <p class="video-description">A conversation on how AI is reshaping the world - its impact on how we live, work, and what it means for individuals, institutions, and society at large.</p>
          </div>
        </div>

        <div class="video-item">
          <div class="video-embed">
            <iframe
              src="https://www.youtube.com/embed/Yr1_51spbio"
              title="AI's Impact on the World - Part 2"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
          <div class="video-meta">
            <p class="video-title">AI's Impact on the World - Part 2</p>
            <p class="video-host">Naxatra News · Interview · May 2026</p>
            <p class="video-description">Continuation of the conversation on how AI is reshaping the world - its impact on how we live, work, and what it means for individuals, institutions, and society at large.</p>
          </div>
        </div>

      </div>
    </section>

    <!-- Press & Published Work -->
    <section class="media-section">
      <h2 class="section-title">Press &amp; Published Work</h2>

      <div class="press-series-group" style="margin-bottom: 2rem;">
        <div class="press-series-header">
          <div class="press-series-left">
            <span class="press-series-outlet">The Pioneer</span>
            <span class="press-series-divider">·</span>
            <span class="press-series-name press-series-name--column">AI 360</span>
          </div>
          <span class="press-series-count">Column · Ongoing</span>
        </div>

        <div class="press-grid">
          <div class="press-card press-card--multi">
            <div class="press-card-top">
              <span class="press-outlet-tag">The Pioneer</span>
              <span class="press-card-date">Aug 21, 2026</span>
            </div>
            <div class="press-card-middle">
              <span class="press-part-label">Edition 1</span>
              <p class="press-card-title">Public Resources Are Used to Create AI Wealth. Should the Public Get a Share?</p>
            </div>
            <div class="press-card-links">
              <a class="press-card-link" href="/media/Pioneer-AI360-Edition1-OriginalClipping.pdf" target="_blank" rel="noopener">View clipping →</a>
              <a class="press-card-link" href="/media/Pioneer-AI360-Edition1-FrontPage.pdf" target="_blank" rel="noopener">Front page →</a>
            </div>
          </div>
        </div>
      </div>

      <div class="press-series-group">
        <div class="press-series-header">
          <div class="press-series-left">
            <span class="press-series-outlet">The Pioneer</span>
            <span class="press-series-divider">·</span>
            <span class="press-series-name">Marriage, Tradition &amp; the Lives We Need to Build Together</span>
          </div>
          <span class="press-series-count">4-part series · Op-Ed</span>
        </div>

        <div class="press-grid">

          <a class="press-card" href="/media/Pioneer-Part1-OriginalClipping.pdf" target="_blank" rel="noopener">
            <div class="press-card-top">
              <span class="press-outlet-tag">The Pioneer</span>
              <span class="press-card-date">May 23, 2026</span>
            </div>
            <div class="press-card-middle">
              <span class="press-part-label">Part 1</span>
              <p class="press-card-title">When Marriage Becomes a Moral Obsession</p>
            </div>
            <span class="press-card-link">View clipping →</span>
          </a>

          <a class="press-card" href="/media/Pioneer-Part2-OriginalClipping.pdf" target="_blank" rel="noopener">
            <div class="press-card-top">
              <span class="press-outlet-tag">The Pioneer</span>
              <span class="press-card-date">May 30, 2026</span>
            </div>
            <div class="press-card-middle">
              <span class="press-part-label">Part 2</span>
              <p class="press-card-title">The Past Is Not the Person</p>
            </div>
            <span class="press-card-link">View clipping →</span>
          </a>

          <a class="press-card" href="/media/Pioneer-Part3-OriginalClipping.pdf" target="_blank" rel="noopener">
            <div class="press-card-top">
              <span class="press-outlet-tag">The Pioneer</span>
              <span class="press-card-date">May 31, 2026</span>
            </div>
            <div class="press-card-middle">
              <span class="press-part-label">Part 3</span>
              <p class="press-card-title">Seven Vows, Zero Preparation</p>
            </div>
            <span class="press-card-link">View clipping →</span>
          </a>

          <a class="press-card" href="/media/Pioneer-Part4-OriginalClipping.pdf" target="_blank" rel="noopener">
            <div class="press-card-top">
              <span class="press-outlet-tag">The Pioneer</span>
              <span class="press-card-date">Jun 2, 2026</span>
            </div>
            <div class="press-card-middle">
              <span class="press-part-label">Part 4</span>
              <p class="press-card-title">Testing the Marriage Before the Wedding</p>
            </div>
            <span class="press-card-link">View clipping →</span>
          </a>

        </div>
      </div>


    </section>

    <!-- Events & Talks -->
    <section class="media-section">
      <h2 class="section-title">Events &amp; Talks</h2>

      <div class="event-block">
        <div class="event-header">
          <span class="event-name">IIM Ranchi - Startup Conclave</span>
          <span class="event-meta">Feb 2026 · Invited as distinguished guest · Panelist and Judge</span>
        </div>
        <div class="ribbon-wrapper">
          <div class="ribbon-track">
            {[...Array(2)].flatMap(() => [
              { src: "/media/IIM_PanelDiscussion.JPG", caption: "Panel discussion 1" },
              { src: "/media/IIM_StartupConclave-Speaking.JPG", caption: "Panel discussion 2" },
              { src: "/media/IIM_StartupConclave-PanelDiscussion.jpeg", caption: "MSME-Startup Collaboration" },
              { src: "/media/IIM_AwardPlaque.JPG", caption: "Felicitated as judge & guest speaker" },
            ]).map((p) => (
              <figure class="photo-item">
                <img src={p.src} alt={p.caption} loading="lazy" />
                <figcaption>{p.caption}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </div>

      <div class="event-block">
        <div class="event-header">
          <span class="event-name">Coal India Group - Applied AI in Mining</span>
          <span class="event-meta">Jul-Aug 2026 · Across Coal India institutions - IICM &amp; CMPDIL · AI Envisioning sessions for HoDs &amp; Senior Executives</span>
        </div>

        <div class="event-subsection">
          <p class="subsection-label">CMPDI HQ, Ranchi</p>
          <div class="ribbon-wrapper">
            <div class="ribbon-track">
              {[...Array(2)].flatMap(() => [
                { src: "/media/Website5.JPG", caption: "Applied AI in Mining - session opening" },
                { src: "/media/Website6.JPG", caption: "AI 101: just enough, no jargon" },
                { src: "/media/Website1.JPG", caption: "Applied AI in Mining - full room" },
                { src: "/media/Website2.JPG", caption: "Live session - AI use cases in mining" },
                { src: "/media/Website3.JPG", caption: "6 Mining firms, 6 Entry Points into AI" },
                { src: "/media/Website4.JPG", caption: "Pilot Opportunity Identification" },
              ]).map((p) => (
                <figure class="photo-item">
                  <img src={p.src} alt={p.caption} loading="lazy" />
                  <figcaption>{p.caption}</figcaption>
                </figure>
              ))}
            </div>
          </div>
        </div>

        <div class="event-subsection">
          <p class="subsection-label">CMPDI RI-VI, Singrauli &amp; Indian Institute of Coal Management</p>
          <div class="collage-row">
            <div class="collage-track">
              <div class="collage-set">
                <figure class="collage-item">
                  <img src="/media/CMPDIL-Singrauli-Collage2.jpg" alt="Felicitation and AI Envisioning session for CMPDI RI-VI Singrauli executives" loading="lazy" />
                  <figcaption>Felicitation and AI Envisioning session - CMPDI RI-VI, Singrauli</figcaption>
                </figure>
                <figure class="collage-item">
                  <img src="/media/CMPDIL-Singrauli-Collage1.jpg" alt="Group photos with CMPDI RI-VI Singrauli participants" loading="lazy" />
                  <figcaption>With CMPDI RI-VI, Singrauli participants</figcaption>
                </figure>
                <figure class="collage-item">
                  <img src="/media/IICM-Collage.jpg" alt="Discovering Opportunities for AI Layer - IICM" loading="lazy" />
                  <figcaption>Discovering Opportunities for AI Layer - IICM</figcaption>
                </figure>
              </div>
              <div class="collage-set collage-set--dup" aria-hidden="true">
                <figure class="collage-item">
                  <img src="/media/CMPDIL-Singrauli-Collage2.jpg" alt="" loading="lazy" />
                  <figcaption>Felicitation and AI Envisioning session - CMPDI RI-VI, Singrauli</figcaption>
                </figure>
                <figure class="collage-item">
                  <img src="/media/CMPDIL-Singrauli-Collage1.jpg" alt="" loading="lazy" />
                  <figcaption>With CMPDI RI-VI, Singrauli participants</figcaption>
                </figure>
                <figure class="collage-item">
                  <img src="/media/IICM-Collage.jpg" alt="" loading="lazy" />
                  <figcaption>Discovering Opportunities for AI Layer - IICM</figcaption>
                </figure>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="event-block">
        <div class="event-header">
          <span class="event-name">State Administrative Training Institute</span>
          <span class="event-meta">Jan-June 2026 · AI-enabled 438 Civil Servants &amp; Government Officers</span>
        </div>
        {skipaSections.map((sub, i) => (
          <div class="event-subsection">
            <p class="subsection-label">{sub.label}</p>
            <div class="ribbon-wrapper">
              <div class="ribbon-track" style={i === 0 ? "animation-duration: 60s" : undefined}>
                {[...sub.photos, ...sub.photos].map((p) => (
                  <figure class={`photo-item${p.contain ? ' photo-item--contain' : ''}`}>
                    <img src={p.src} alt={p.caption} loading="lazy" style={p.position ? `object-position: ${p.position}` : undefined} />
                    <figcaption>{p.caption}</figcaption>
                  </figure>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>

    </section>

  </div>
</BaseLayout>

<style>
  .media-page {
    max-width: 100%;
  }

  .page-header {
    max-width: 1000px;
    margin-bottom: 4rem;
  }

  .page-header h1 {
    font-size: clamp(2.6rem, 4.5vw, 3.4rem); letter-spacing: -0.03em; line-height: 1.1;
    margin-bottom: 1rem;
    font-weight: 500;
  }

  .page-description {
    font-size: 1.125rem;
    color: var(--text-secondary);
    line-height: 1.8;
  }

  .media-section {
    margin-bottom: 4rem;
    padding-bottom: 4rem;
    border-bottom: 1px solid var(--border);
  }

  .media-section:last-child {
    border-bottom: none;
  }

  .section-title {
    max-width: 1000px;
    font-size: 1.25rem;
    font-weight: 500;
    margin-bottom: 1.75rem;
    font-family: var(--font-heading);
    color: var(--text-primary);
    letter-spacing: 0.02em;
  }

  /* Video / Audio cards */
  .video-grid {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    max-width: 760px;
  }

  .video-item {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .video-embed {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: rgba(255,255,255,0.04);
  }

  .video-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .video-embed--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px dashed rgba(255,255,255,0.15);
  }

  .placeholder-label {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }

  .video-embed--photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .upcoming-badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background: rgba(15, 22, 32, 0.85);
    border: 1px solid rgba(255,255,255,0.15);
    color: var(--text-primary);
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    padding: 0.3rem 0.65rem;
    border-radius: 4px;
  }

  .video-item--upcoming .video-title,
  .video-item--upcoming .video-description {
    color: var(--text-secondary);
  }

  .video-item--upcoming .video-host {
    font-style: italic;
  }

  .video-title {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-primary);
    line-height: 1.5;
    margin: 0;
  }

  .video-host {
    font-size: 0.8rem;
    font-family: var(--font-heading);
    color: var(--text-muted);
    letter-spacing: 0.03em;
    margin: 0;
  }

  .video-outlet-desc {
    font-size: 0.78rem;
    color: var(--text-muted);
    font-style: italic;
    margin: 0;
    line-height: 1.5;
  }

  .video-description {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  /* Press & Published Work */
  .press-series-group {
    max-width: 760px;
  }

  .press-series-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .press-series-left {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .press-series-outlet {
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .press-series-divider {
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  .press-series-name {
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    font-weight: 400;
    color: var(--text-muted);
  }

  .press-series-name--column {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .press-series-count {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    color: var(--text-muted);
    white-space: nowrap;
    letter-spacing: 0.02em;
  }

  .press-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 0.5rem;
  }

  .press-list-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    font-family: var(--font-heading);
    font-size: 0.85rem;
  }

  .press-list-row:last-child {
    border-bottom: none;
  }

  .press-list-edition {
    color: var(--text-muted);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    min-width: 60px;
  }

  .press-list-dot {
    color: var(--text-muted);
  }

  .press-list-date {
    color: var(--text-muted);
    font-size: 0.75rem;
    min-width: 90px;
  }

  .press-list-title {
    color: var(--text-primary);
    flex: 1;
  }

  .press-list-link {
    color: var(--accent);
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .press-list-row--soon .press-list-date {
    font-style: italic;
  }

  .press-list-row--soon .press-list-link {
    color: var(--text-muted);
  }

  .press-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }

  .press-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: #1A3A5C;
    border-radius: 8px;
    padding: 1rem 1.1rem;
    text-decoration: none;
    color: inherit;
    transition: opacity 0.2s ease;
  }

  .press-card:hover {
    opacity: 0.88;
  }

  .press-card--soon {
    background: rgba(26, 58, 92, 0.25);
    border: 0.5px solid rgba(26, 58, 92, 0.3);
    cursor: default;
    pointer-events: none;
  }

  .press-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .press-outlet-tag {
    font-family: var(--font-heading);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #3EC9A7;
  }

  .press-outlet-tag--muted {
    color: rgba(255, 255, 255, 0.25);
  }

  .press-card-date {
    font-family: var(--font-heading);
    font-size: 10px;
    color: rgba(255, 255, 255, 0.4);
    letter-spacing: 0.03em;
    white-space: nowrap;
  }

  .press-card-middle {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    flex: 1;
  }

  .press-part-label {
    font-family: var(--font-heading);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
  }

  .press-part-label--muted {
    color: rgba(255, 255, 255, 0.2);
  }

  .press-card-title {
    font-size: 14px;
    font-weight: 500;
    color: #fff;
    line-height: 1.45;
    margin: 0;
  }

  .press-card-desc {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.5;
    margin: 0.4rem 0 0 0;
  }

  .press-card-title--muted {
    color: rgba(255, 255, 255, 0.25);
    font-style: italic;
    font-weight: 400;
  }

  .press-card-link {
    font-family: var(--font-heading);
