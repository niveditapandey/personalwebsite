---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Newsletters - Nivedita Pandey" description="Three publications on AI governance, Asia's AI ecosystem, and society - written for practitioners, founders, and policymakers.">
  <div class="newsletter-page">
    <header class="page-header">
      <h1>Newsletters</h1>
      <p class="page-description">
        Three publications covering AI, governance, and society - each written for a different reader.
      </p>
    </header>

    <div class="pub-list">

      <div class="pub-item">
        <div class="pub-header">
          <div>
            <p class="pub-tag">AI · Policy · Institutions</p>
            <h2 class="pub-name">AI &amp; Governance</h2>
          </div>
          <a class="pub-subscribe" href="https://niveditapandey.substack.com" target="_blank" rel="noopener noreferrer">Subscribe →</a>
        </div>
        <p class="pub-description">
          On institutional AI adoption, digital public infrastructure, and the gap between technical
          possibility and policy reality. Written for practitioners - in government, multilaterals,
          and enterprise - who are navigating AI implementation without a map.
        </p>
        <p class="pub-meta">Monthly · niveditapandey.substack.com</p>
      </div>

      <div class="pub-item">
        <div class="pub-header">
          <div>
            <p class="pub-tag">AI · Asia · Ecosystem</p>
            <h2 class="pub-name">Asia AI Foundry</h2>
          </div>
          <a class="pub-subscribe" href="https://asiaaifoundry.substack.com" target="_blank" rel="noopener noreferrer">Subscribe →</a>
        </div>
        <p class="pub-description">
          On AI adoption, investment, and ecosystem building across Asia - with a focus on how
          different markets are approaching AI readiness, regulation, and deployment. For founders,
          investors, and policymakers thinking about AI in the Asian context.
        </p>
        <p class="pub-meta">Monthly · asiaaifoundry.substack.com</p>
      </div>

      <div class="pub-item">
        <div class="pub-header">
          <div>
            <p class="pub-tag">Society · Culture · Ideas</p>
            <h2 class="pub-name">The Uncomfortable Enquiry</h2>
          </div>
          <a class="pub-subscribe" href="https://mindunruled.substack.com" target="_blank" rel="noopener noreferrer">Subscribe →</a>
        </div>
        <p class="pub-description">
          On society, culture, and the questions that make people uncomfortable - marriage, tradition,
          identity, and the unspoken rules that govern how we live. A different register from the AI
          work: more personal, more argumentative.
        </p>
        <p class="pub-meta">Irregular · mindunruled.substack.com</p>
      </div>

    </div>
  </div>
</BaseLayout>

<style>
  .newsletter-page {
    max-width: 700px;
  }

  .page-header {
    margin-bottom: 3.5rem;
  }

  .page-header h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    font-weight: 500;
  }

  .page-description {
    font-size: 1.125rem;
    color: var(--text-secondary);
    line-height: 1.8;
  }

  .pub-list {
    display: flex;
    flex-direction: column;
  }

  .pub-item {
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .pub-item:last-child {
    border-bottom: none;
  }

  .pub-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .pub-tag {
    font-family: var(--font-heading);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 0.35rem;
  }

  .pub-name {
    font-size: 1.375rem;
    font-weight: 500;
    color: var(--text-primary);
    font-family: var(--font-heading);
    margin: 0;
  }

  .pub-subscribe {
    font-family: var(--font-heading);
    font-size: 0.82rem;
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
    padding-top: 0.2rem;
    transition: opacity 0.2s ease;
    flex-shrink: 0;
  }

  .pub-subscribe:hover {
    opacity: 0.7;
  }

  .pub-description {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.8;
    margin: 0;
  }

  .pub-meta {
    font-family: var(--font-heading);
    font-size: 0.72rem;
    color: var(--text-muted);
    letter-spacing: 0.03em;
    margin: 0;
  }

  @media (max-width: 768px) {
    .page-header h1 {
      font-size: 2rem;
    }

    .pub-header {
      flex-direction: column;
      gap: 0.75rem;
    }
  }
</style>
